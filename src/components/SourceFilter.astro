---
const sources = ["全部工作台", "全能的野人", "娟姐", "王多于", "阿龙"];
---

<section class="source-filter" aria-label="来源筛选">
  <span>来源聚合：</span>
  <div class="filter-buttons">
    {sources.map((source, index) => (
      <button class={index === 0 ? "active" : ""} type="button">{source}</button>
    ))}
  </div>
</section>
