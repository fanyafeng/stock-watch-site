---
import BaseLayout from "../layouts/BaseLayout.astro";
import DashboardLayout from "./DashboardLayout.astro";
import MyPositionsUnlock from "./MyPositionsUnlock.astro";
import MyDatePicker from "./MyDatePicker.astro";
import dashboard from "../data/dashboard.json";
import myIndex from "../data/my_positions_index.json";

const { selectedDate, payload } = Astro.props;
const dates = myIndex.map((item) => item.date);
const latestDate = dates[0] ?? dashboard.date;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const positionsHref = selectedDate === latestDate ? `${base}/my-positions/` : `${base}/my-positions/${selectedDate}/`;
---

<BaseLayout title={`每日复盘｜${selectedDate}`}>
  <DashboardLayout active="每日复盘">
    <header class="topbar">
      <div>
        <p>每日复盘 / 模拟盘</p>
        <h1>两票交易账本</h1>
        <span>默认同步本地模拟盘；真实买卖请以实际操作截图为准。</span>
      </div>
      <div class="topbar-actions">
        <time datetime={selectedDate}>{selectedDate ?? "暂无日期"}</time>
        <a href={positionsHref}>操作记录页</a>
      </div>
    </header>

    <section class="my-review-toolbar" aria-label="每日复盘日期选择">
      <div>
        <strong>复盘日期</strong>
        <span>按年月日切换账本</span>
      </div>
      <MyDatePicker dates={dates} selectedDate={selectedDate} rootPath="/" datePath="/review/" />
    </section>

    {payload ? (
      <MyPositionsUnlock payload={payload} selectedDate={selectedDate} />
    ) : (
      <section class="panel public-empty" style="padding: 64px 24px; text-align: center;">
        <div class="video-empty">
          <div class="video-icon" style="margin-bottom: 18px; border-color: rgba(105, 137, 171, 0.28); color: var(--muted); border-radius: 14px;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <strong style="display: block; font-size: 18px; color: var(--text); margin-bottom: 10px;">暂无可解锁的复盘账本</strong>
          <p style="margin: 0; font-size: 14px;">当前日期 {selectedDate} 尚未生成加密账本数据。</p>
          <div style="margin-top: 20px;">
            <code style="display: inline-block; padding: 10px 16px; background: rgba(0,0,0,0.25); border: 1px solid rgba(105, 137, 171, 0.18); border-radius: 8px; color: var(--blue); font-size: 13px;">python scripts/build_my_trade_review.py --date {selectedDate}</code>
          </div>
        </div>
      </section>
    )}
  </DashboardLayout>
</BaseLayout>
