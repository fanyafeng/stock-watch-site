---
const {
  payload,
  autoPrompt = false,
  title = "请输入文章密码",
  description = "密码只在本机浏览器内用于解密，不会上传或明文存储。"
} = Astro.props;
const payloadJson = JSON.stringify(payload);
const payloadKey = String(payload?.salt ?? "default").replace(/[^a-zA-Z0-9]/g, "").slice(0, 8) || "default";
const inputId = `article-password-${payloadKey}`;
---

<section class:list={["decryptor", autoPrompt && "decryptor--prompt"]} data-payload={payloadJson} data-auto-prompt={autoPrompt ? "true" : "false"}>
  {autoPrompt && (
    <div class="decryptor-lock" data-lock-card>
      <div>
        <span>内容已加密</span>
        <strong data-lock-title>{title}</strong>
        <p data-lock-description>{description}</p>
      </div>
      <button type="button" data-open-modal>输入密码</button>
    </div>
  )}

  {autoPrompt && (
    <div class="decryptor-modal" data-password-modal role="dialog" aria-modal="true" aria-labelledby={`${inputId}-dialog-title`}>
      <div class="decryptor-modal__shade" data-close-modal></div>
      <div class="decryptor-modal__panel">
        <button class="decryptor-modal__close" type="button" aria-label="稍后再输入" data-close-modal>×</button>
        <p>私密复盘</p>
        <h2 id={`${inputId}-dialog-title`} data-dialog-title>{title}</h2>
        <span data-dialog-description>{description}</span>
        <slot name="modal-extra" />
        <div class="decryptor__controls decryptor__controls--modal" data-decrypt-form>
          <input id={inputId} data-password-input name="password" type="password" autocomplete="current-password" placeholder="输入每日复盘密码" />
          <button type="button" data-decrypt>解密查看</button>
        </div>
        <p class="decryptor__error" data-error hidden>密码错误或文章无法解密</p>
      </div>
    </div>
  )}

  <div class="decryptor__inline" data-inline-unlock hidden={autoPrompt}>
    <label for={autoPrompt ? `${inputId}-inline` : inputId}>请输入文章密码</label>
    <div class="decryptor__controls" data-decrypt-form>
      <input id={autoPrompt ? `${inputId}-inline` : inputId} data-password-input name="password" type="password" autocomplete="current-password" />
      <button type="button" data-decrypt>解密查看</button>
    </div>
    <p class="decryptor__error" data-error hidden>密码错误或文章无法解密</p>
  </div>

  <article class="article-body" data-article hidden></article>
</section>

<script>
  function base64ToBytes(value) {
    const raw = window.atob(value);
    const bytes = new Uint8Array(raw.length);
    for (let index = 0; index < raw.length; index += 1) bytes[index] = raw.charCodeAt(index);
    return bytes;
  }

  async function decryptPayload(payload, password) {
    const encoder = new TextEncoder();
    const keyMaterial = await crypto.subtle.importKey(
      "raw",
      encoder.encode(password),
      "PBKDF2",
      false,
      ["deriveKey"]
    );
    const key = await crypto.subtle.deriveKey(
      {
        name: "PBKDF2",
        salt: base64ToBytes(payload.salt),
        iterations: payload.iterations,
        hash: "SHA-256"
      },
      keyMaterial,
      { name: "AES-GCM", length: 256 },
      false,
      ["decrypt"]
    );
    const plainBuffer = await crypto.subtle.decrypt(
      { name: "AES-GCM", iv: base64ToBytes(payload.iv) },
      key,
      base64ToBytes(payload.ciphertext)
    );
    return new TextDecoder().decode(plainBuffer);
  }

  function readPayload(root) {
    return JSON.parse(root.getAttribute("data-payload") || "{}");
  }

  for (const root of document.querySelectorAll(".decryptor")) {
    const modal = root.querySelector("[data-password-modal]");
    const lockCard = root.querySelector("[data-lock-card]");
    const inlineUnlock = root.querySelector("[data-inline-unlock]");
    const inputs = root.querySelectorAll("[data-password-input]");
    const errors = root.querySelectorAll("[data-error]");
    const buttons = root.querySelectorAll("[data-decrypt]");
    const article = root.querySelector("[data-article]");
    const autoPrompt = root.getAttribute("data-auto-prompt") === "true";

    const hideErrors = () => {
      for (const error of errors) error.hidden = true;
    };

    const openModal = () => {
      if (!modal) return;
      modal.hidden = false;
      requestAnimationFrame(() => modal.querySelector("[data-password-input]")?.focus());
    };

    const closeModal = () => {
      if (modal) modal.hidden = true;
    };

    const resetDecryptor = (event) => {
      for (const input of inputs) input.value = "";
      hideErrors();
      article.hidden = true;
      article.innerHTML = "";
      lockCard?.removeAttribute("hidden");
      if (inlineUnlock) inlineUnlock.hidden = autoPrompt;
      if (event?.detail?.reopen !== false && autoPrompt) openModal();
    };

    const setLoading = (loading) => {
      for (const button of buttons) button.disabled = loading;
    };

    const runDecrypt = async (trigger) => {
      const form = trigger?.closest("[data-decrypt-form]");
      const input = form?.querySelector("[data-password-input]") ?? inputs[0];
      const password = input?.value ?? "";
      hideErrors();
      article.hidden = true;
      article.innerHTML = "";
      setLoading(true);
      try {
        const payload = readPayload(root);
        const html = await decryptPayload(payload, password);
        article.innerHTML = html;
        article.hidden = false;
        lockCard?.setAttribute("hidden", "");
        if (inlineUnlock) inlineUnlock.hidden = true;
        closeModal();
        article.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch {
        for (const error of errors) error.hidden = false;
      } finally {
        setLoading(false);
      }
    };

    root.querySelectorAll("[data-open-modal]").forEach((button) => {
      button.addEventListener("click", openModal);
    });
    root.querySelectorAll("[data-close-modal]").forEach((button) => {
      button.addEventListener("click", closeModal);
    });
    buttons.forEach((button) => {
      button.addEventListener("click", () => runDecrypt(button));
    });
    inputs.forEach((input) => {
      input.addEventListener("input", hideErrors);
      input.addEventListener("keydown", (event) => {
        if (event.key === "Enter") runDecrypt(input);
        if (event.key === "Escape") closeModal();
      });
    });
    root.addEventListener("decryptor:open", openModal);
    root.addEventListener("decryptor:reset", resetDecryptor);

    if (autoPrompt) openModal();
  }
</script>
