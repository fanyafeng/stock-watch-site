---
const { report } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = `${base}${report.url}`;
const actionLabel = report.report_type === "daily_workbench" ? "进入复盘工作台" : "查看加密报告";
---

<article class="report-card">
  <div class="report-card__meta">
    <span>{report.source_name}</span>
    <time datetime={report.date}>{report.date}</time>
  </div>
  <h2>{report.title}</h2>
  <p>{report.summary}</p>
  <div class="tags" aria-label="报告标签">
    {report.tags.map((tag) => <span>{tag}</span>)}
  </div>
  <a class="button-link" href={href}>{actionLabel}</a>
</article>
