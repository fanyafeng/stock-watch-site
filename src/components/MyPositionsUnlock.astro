---
const { payload, selectedDate, availableDates = [] } = Astro.props;
const payloadJson = JSON.stringify(payload);
---

<section class="my-unlock" data-payload={payloadJson}>
  <div class="my-unlock__head">
    <div>
      <p>我的持仓 / 操作记录</p>
      <h2>密码解锁区</h2>
      <span>刷新页面后需要重新输入密码；页面不会显示密码规则。</span>
    </div>
    <form class="my-date-form" method="get">
      <label for="my-position-date">选择日期</label>
      <input id="my-position-date" name="date" type="date" value={selectedDate} list="my-position-dates" />
      <datalist id="my-position-dates">
        {availableDates.map((date) => <option value={date}></option>)}
      </datalist>
      <button type="submit">切换</button>
    </form>
  </div>

  <div class="my-unlock__box" data-lock-panel>
    <div>
      <strong>请输入我的持仓密码</strong>
      <span>解锁后仅在当前页面会话内展示。</span>
    </div>
    <div class="my-unlock__controls">
      <input type="password" autocomplete="current-password" aria-label="我的持仓密码" />
      <button type="button" data-unlock>解锁查看</button>
    </div>
    <p class="my-unlock__error" data-error hidden>密码错误，无法查看我的持仓记录</p>
  </div>

  <article class="my-private-content" data-private-content hidden></article>
</section>

<script>
  function base64ToBytes(value) {
    const raw = window.atob(value);
    const bytes = new Uint8Array(raw.length);
    for (let index = 0; index < raw.length; index += 1) bytes[index] = raw.charCodeAt(index);
    return bytes;
  }

  async function decryptMyPayload(payload, password) {
    const encoder = new TextEncoder();
    const keyMaterial = await crypto.subtle.importKey(
      "raw",
      encoder.encode(password),
      "PBKDF2",
      false,
      ["deriveKey"]
    );
    const key = await crypto.subtle.deriveKey(
      {
        name: "PBKDF2",
        salt: base64ToBytes(payload.salt),
        iterations: payload.iterations,
        hash: "SHA-256"
      },
      keyMaterial,
      { name: "AES-GCM", length: 256 },
      false,
      ["decrypt"]
    );
    const plainBuffer = await crypto.subtle.decrypt(
      { name: "AES-GCM", iv: base64ToBytes(payload.iv) },
      key,
      base64ToBytes(payload.ciphertext)
    );
    return new TextDecoder().decode(plainBuffer);
  }

  for (const root of document.querySelectorAll(".my-unlock")) {
    const payload = JSON.parse(root.getAttribute("data-payload") || "{}");
    const input = root.querySelector("input[type='password']");
    const button = root.querySelector("[data-unlock]");
    const error = root.querySelector("[data-error]");
    const content = root.querySelector("[data-private-content]");
    const lockPanel = root.querySelector("[data-lock-panel]");

    const runUnlock = async () => {
      error.hidden = true;
      content.hidden = true;
      content.innerHTML = "";
      try {
        const html = await decryptMyPayload(payload, input.value);
        content.innerHTML = html;
        content.hidden = false;
        lockPanel.classList.add("is-unlocked");
      } catch {
        error.hidden = false;
      }
    };

    button.addEventListener("click", runUnlock);
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") runUnlock();
    });
  }
</script>
