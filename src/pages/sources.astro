---
import BaseLayout from "../layouts/BaseLayout.astro";
import DashboardLayout from "../components/DashboardLayout.astro";
import dashboard from "../data/dashboard.json";
import sourceStockTracks from "../data/source_stock_tracks.json";

const sources = dashboard.sources ?? [];
const sourceColors = { yege: "blue", lihongjuan: "purple", wangduoyu: "green", longge: "orange" };
const activeSource = sources[0] ?? {};
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const yegeTrackData = sourceStockTracks.sources?.yege ?? {};
const yegeTracks = yegeTrackData.tracks ?? [];
const yegeStats = yegeTrackData.stats ?? {};
const shownTrackCards = yegeTracks.slice(0, 4);
const formatPct = (value) => typeof value === "number" ? `${value > 0 ? "+" : ""}${value.toFixed(2)}%` : "待行情";
const pctClass = (value) => typeof value === "number" ? (value >= 0 ? "danger-text" : "green-text") : "muted-text";
const formatPrice = (value) => typeof value === "number" ? value.toFixed(2) : "待行情";
const mediaUrl = (value = "") => value.startsWith("/") ? `${base}${value}` : value;
const actionClass = (status = "") => {
  if (status.includes("卖出") || status.includes("减仓")) return "is-sold";
  if (status.includes("持有")) return "is-hold";
  if (status.includes("观察")) return "is-watch";
  return "is-mention";
};
const primaryEvidence = (track) => {
  const evidence = track.sell_evidence?.length ? track.sell_evidence : track.buy_evidence?.length ? track.buy_evidence : track.latest_evidence ?? [];
  return evidence.slice(0, 4);
};
---

<BaseLayout title="来源人｜复盘工作台">
  <DashboardLayout active="来源人">
    <header class="topbar dark-topbar">
      <div>
        <p>筛选工具箱</p>
        <h1>来源人详情</h1>
        <span>数据更新时间：{dashboard.updated_at ?? "暂无数据"}</span>
      </div>
      <div class="topbar-actions">
        <time datetime={dashboard.date}>{dashboard.date}</time>
        <button type="button">前一天</button>
        <button type="button">后一天</button>
        <a href={`${base}/articles/daily_${dashboard.date}/`}>打开加密详情</a>
      </div>
    </header>

    <nav class="page-tabs">
      {[
        ["首页", "/"],
        ["大盘分析", "/market/"],
        ["来源人", "/sources/"],
        ["综合推荐", "/#selection"],
        ["评论聚合", "/comments/"],
      ].map(([item, href]) => (
        <a class={item === "来源人" ? "active" : ""} href={`${base}${href}`}>{item}</a>
      ))}
    </nav>

    <section class="source-tabs">
      {sources.map((source, index) => (
        <a class={index === 0 ? "active" : ""} href={`#source-${source.id}`}>
          <span class={`avatar ${sourceColors[source.id] ?? ""}`}>{source.name.slice(0, 1)}</span>
          <strong>{source.name}</strong>
          <small>({source.id})</small>
        </a>
      ))}
    </section>

    <section class="source-track-workbench" id="yege-stock-tracks">
      <article class="source-track-hero">
        <div>
          <p>野哥股票跟踪汇总</p>
          <h2>按股票聚合买入、卖出、持有与截图证据</h2>
          <span>统计截至 {sourceStockTracks.date}；收益优先按公开日 K 收盘价估算，截图与买卖点仍需人工核对。</span>
        </div>
        <a href="#source-yege">查看野哥来源</a>
      </article>

      <div class="source-track-stats">
        <article><span>跟踪股票</span><strong>{yegeStats.track_count ?? 0}</strong><small>跨日去重</small></article>
        <article><span>持有 / 观察</span><strong>{yegeStats.active_count ?? 0}</strong><small>未出现卖出线索</small></article>
        <article><span>卖出 / 减仓</span><strong>{yegeStats.sold_count ?? 0}</strong><small>根据帖子关键词识别</small></article>
        <article><span>证据截图</span><strong>{yegeStats.screenshot_count ?? 0}</strong><small>买卖截图与动态截图</small></article>
        <article><span>平均收益</span><strong class={pctClass(yegeStats.avg_return_pct)}>{formatPct(yegeStats.avg_return_pct)}</strong><small>行情可用后自动计算</small></article>
      </div>

      <article class="panel source-track-panel">
        <div class="panel-head">
          <h2>野哥股票跟踪表</h2>
          <span>{sourceStockTracks.price_note}</span>
        </div>
        <div class="source-track-table-wrap">
          <table class="source-track-table">
            <thead>
              <tr>
                <th>股票</th>
                <th>首次入池</th>
                <th>买入 / 首次动作</th>
                <th>卖出 / 最新状态</th>
                <th>区间收益</th>
                <th>证据</th>
                <th>最新摘要</th>
              </tr>
            </thead>
            <tbody>
              {yegeTracks.length ? yegeTracks.map((track) => (
                  <tr>
                    <td>
                      <a class="track-stock-link" href={track.stock_url} target="_blank" rel="noreferrer">
                        <strong>{track.name}</strong>
                        <span>{track.code}</span>
                      </a>
                    </td>
                    <td>
                      <b>{track.first_selected_date || track.first_seen_date}</b>
                      <small>{track.event_count} 条线索</small>
                    </td>
                    <td>
                      <b>{track.buy_date || "待确认"}</b>
                      <small>{track.buy_action || "暂无明确买入动作"}</small>
                    </td>
                    <td>
                      <span class={`track-status ${actionClass(track.status)}`}>{track.status}</span>
                      <small>{track.sell_date ? `卖出线索：${track.sell_date}` : `最新：${track.latest_date}`}</small>
                    </td>
                    <td>
                      <strong class={pctClass(track.return_pct)}>{formatPct(track.return_pct)}</strong>
                      <small>{formatPrice(track.buy_price)} → {formatPrice(track.end_price)}</small>
                    </td>
                    <td>
                      <div class="track-evidence-mini">
                        {primaryEvidence(track).length ? primaryEvidence(track).map((item) => (
                          <a href={mediaUrl(item.image)} target="_blank" rel="noreferrer" title={`${item.date} ${item.action}`}>
                            <img src={mediaUrl(item.image)} alt={`${track.name} ${item.action}截图`} loading="lazy" />
                          </a>
                        )) : <span>暂无截图</span>}
                      </div>
                    </td>
                    <td><p>{track.latest_summary}</p></td>
                  </tr>
                )) : (
                <tr>
                  <td colspan="7">
                    <p class="source-track-empty">暂无野哥股票跟踪数据，请先补充 `data/sources/yege/picks/` 或 `data/sources/yege/posts/` 后重新生成。</p>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </article>

      {shownTrackCards.length ? (
        <div class="source-track-cards">
          {shownTrackCards.map((track) => (
          <article class="source-track-card">
            <header>
              <div>
                <strong>{track.name}</strong>
                <span>{track.code} · {track.status}</span>
              </div>
              <em class={pctClass(track.return_pct)}>{formatPct(track.return_pct)}</em>
            </header>
            <p>{track.latest_summary}</p>
            <div class="track-card-meta">
              <span>买入/首动：{track.buy_date || "待确认"}</span>
              <span>{track.sell_date ? `卖出/减仓：${track.sell_date}` : `最新线索：${track.latest_date}`}</span>
              <span>{track.screenshot_count} 张截图</span>
            </div>
            <div class="track-evidence-row">
              {primaryEvidence(track).slice(0, 3).map((item) => (
                <a href={mediaUrl(item.image)} target="_blank" rel="noreferrer">
                  <img src={mediaUrl(item.image)} alt={`${track.name}证据截图`} loading="lazy" />
                </a>
              ))}
            </div>
          </article>
          ))}
        </div>
      ) : null}
    </section>

    <section class="source-profile-grid" id={`source-${activeSource.id}`}>
      <article class="panel profile-card">
        <div class={`big-avatar ${sourceColors[activeSource.id] ?? ""}`}>{activeSource.name?.slice(0, 1)}</div>
        <div>
          <h2>{activeSource.name} ({activeSource.id})</h2>
          <p>专注短线技术形态，擅长右侧趋势交易。</p>
          <div class="profile-stats"><span>关注 <b>12.8万</b></span><span>帖子总数 <b>1862</b></span><span>今日发帖 <b>{activeSource.top_picks?.length ?? 0}</b></span><span>评论 <b>{activeSource.comment_count ?? 0}</b></span></div>
        </div>
      </article>

      <article class="panel">
        <div class="panel-head"><h2>今日观点摘要</h2><span>{activeSource.channel}</span></div>
        <p class="analysis-copy">{activeSource.latest_summary}</p>
        <div class="chip-row">{activeSource.top_picks?.map((pick) => <em>{pick.name}</em>)}</div>
      </article>

      <article class="panel">
        <div class="panel-head"><h2>历史胜率统计</h2><span>近30天</span></div>
        <div class="donut-block"><div class="donut"><strong>68.3%</strong><span>胜率</span></div><div class="stat-list"><p><span>上涨次数</span><strong>41</strong></p><p><span>下跌次数</span><strong>19</strong></p><p><span>平均收益率</span><strong class="danger-text">+3.85%</strong></p></div></div>
      </article>

      <article class="panel">
        <div class="panel-head"><h2>擅长领域</h2><span>标签</span></div>
        <div class="chip-row">{["短线波段", "右侧交易", "底部突破", "中继回踩", "消费电子", "PCB", "半导体"].map((item) => <em>{item}</em>)}</div>
      </article>
    </section>

    <section class="all-source-panels">
      {sources.slice(1).map((source) => (
        <article class="panel source-anchor-card" id={`source-${source.id}`}>
          <div class={`avatar big-avatar ${sourceColors[source.id] ?? ""}`}>{source.name.slice(0, 1)}</div>
          <div>
            <div class="panel-head">
              <h2>{source.name} ({source.id})</h2>
              <span>{source.channel}</span>
            </div>
            <p class="analysis-copy">{source.latest_summary}</p>
            <div class="chip-row">
              {source.top_picks?.map((pick) => <em>{pick.name}</em>)}
              {source.holdings?.map((holding) => <em>持仓：{holding.name}</em>)}
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="source-page-grid" id="data">
      <article class="panel">
        <div class="panel-head"><h2>1 今日帖子 / 图文内容</h2><span>{activeSource.channel}</span></div>
        <div class="post-list">
          {[1, 2].map((item) => (
            <div class="post-item">
              <time>{item === 1 ? "10:12" : "14:05"}</time>
              <strong>{activeSource.latest_title}</strong>
              <p>{activeSource.latest_summary}</p>
              <div class="thumb-row"><i></i><i></i><i></i><i></i></div>
              <small>提到股票：{activeSource.top_picks?.map((pick) => pick.name).join("、")}</small>
            </div>
          ))}
        </div>
      </article>

      <article class="panel">
        <div class="panel-head"><h2>2 今日选股推荐</h2><span>公开概要</span></div>
        <table class="compact-table">
          <thead><tr><th>代码</th><th>名称</th><th>形态</th><th>状态</th><th>评分</th></tr></thead>
          <tbody>{activeSource.top_picks?.map((pick, index) => <tr><td>{pick.code}</td><td>{pick.name}</td><td>{pick.pattern}</td><td class="green-text">等待买点</td><td>{88 - index * 3}</td></tr>)}</tbody>
        </table>
      </article>

      <article class="panel">
        <div class="panel-head"><h2>3 个人持仓情况</h2><span>CSV 汇总</span></div>
        <table class="compact-table">
          <thead><tr><th>代码</th><th>名称</th><th>仓位</th><th>状态</th><th>操作计划</th></tr></thead>
          <tbody>{activeSource.holdings?.map((holding) => <tr><td>{holding.code}</td><td>{holding.name}</td><td>{holding.position_ratio}</td><td class="green-text">{holding.status}</td><td>控制仓位，等待确认</td></tr>)}</tbody>
        </table>
      </article>

      <article class="panel">
        <div class="panel-head"><h2>4 有价值评论精选</h2><span>来自帖子评论</span></div>
        <table class="compact-table"><tbody>{["胜宏科技这个位置放量突破，主力明显控盘。", "沪电股份近期承接强，800G 交换机需求明显。", "中际旭创朗润高了，短期有回调需求。"].map((text) => <tr><td>{text}</td><td class="star-text">★★★★★</td><td class="green-text">纳入</td></tr>)}</tbody></table>
      </article>

      <article class="panel video-empty">
        <div class="panel-head"><h2>5 今日视频 / 直播</h2><span>如有</span></div>
        <div class="video-icon">▰</div>
        <p>该来源今日暂无视频或直播记录，可补充 posts CSV。</p>
      </article>

      <article class="panel">
        <div class="panel-head"><h2>6 历史选股表现</h2><span>近7天</span></div>
        <table class="compact-table"><tbody>{["06-05", "06-04", "06-03", "06-02", "05-30"].map((day, index) => <tr><td>{day}</td><td>{8 - index}</td><td>{index % 2 ? "71.4%" : "85.0%"}</td><td class="green-text">+{(3.21 - index * 0.22).toFixed(2)}%</td></tr>)}</tbody></table>
      </article>
    </section>
  </DashboardLayout>
</BaseLayout>
