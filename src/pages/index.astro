---
import BaseLayout from "../layouts/BaseLayout.astro";
import DashboardLayout from "../components/DashboardLayout.astro";
import MyPositionsUnlock from "../components/MyPositionsUnlock.astro";
import dashboard from "../data/dashboard.json";
import myIndex from "../data/my_positions_index.json";

const dates = myIndex.map((item) => item.date);
const requestedDate = Astro.url.searchParams.get("date");
const selectedDate = requestedDate && dates.includes(requestedDate) ? requestedDate : (dates[0] ?? dashboard.date);
const selectedItem = myIndex.find((item) => item.date === selectedDate) ?? myIndex[0];
const payloadModule = selectedItem ? await import(`../../encrypted/my/${selectedItem.date}.json`) : null;
const payload = payloadModule?.default ?? null;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="每日复盘｜冠捷科技与山东玻纤">
  <DashboardLayout active="每日复盘">
    <section class="daily-unlock-page">
      <header class="daily-unlock-hero">
        <div>
          <p>每日复盘 / 两票模拟盘</p>
          <h1>冠捷科技与山东玻纤交易账本</h1>
          <span>默认同步本地模拟盘；你的真实买卖只在你确认一致并给截图后写入。</span>
        </div>
        <div class="daily-unlock-meta">
          <span>当前日期</span>
          <time datetime={selectedDate}>{selectedDate ?? "暂无日期"}</time>
          <a href={`${base}/my-positions/?date=${selectedDate}`}>操作记录页</a>
        </div>
      </header>

      {dates.length > 1 && (
        <section class="daily-date-panel" aria-labelledby="daily-date-title">
          <div class="daily-date-panel__head">
            <div>
              <h2 id="daily-date-title">切换日期</h2>
              <p>只展示已生成加密账本的日期。</p>
            </div>
            <span>{dates.length} 天</span>
          </div>
          <div class="daily-unlock-dates" role="list" aria-label="历史每日复盘">
            {dates.slice(0, 14).map((date) => (
              <a class={date === selectedDate ? "active" : ""} href={`${base}/?date=${date}`} role="listitem">
                <span>{date}</span>
                <strong>两票账本</strong>
                <em>解锁查看</em>
              </a>
            ))}
          </div>
        </section>
      )}

      {payload ? (
        <MyPositionsUnlock payload={payload} selectedDate={selectedDate} availableDates={dates} />
      ) : (
        <section class="panel empty-comment-state">
          <strong>暂无可解锁的每日复盘账本</strong>
          <p>请先运行 <code>python scripts/build_my_trade_review.py --date {selectedDate}</code> 和 <code>python scripts/encrypt_my_positions.py --date {selectedDate} --mode loose</code>。</p>
        </section>
      )}
    </section>
  </DashboardLayout>
</BaseLayout>
